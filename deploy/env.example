# The production environment: copy to deploy/.env (never committed) and fill in.
# The containers read it (src/magnet/settings_prod.py), deploy/compose.yml takes the
# paths from it. See README "Deployment".

DJANGO_SETTINGS_MODULE=magnet.settings_prod
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# get the tracebacks of server errors (space-separated)
DJANGO_ADMINS=mail@supercollider.online

# the website (MAGNET_HOST for the health check), downloads and the index mirror
MAGNET_HOST=magnet.supercollider.online
MAGNET_API_BASE_URL=https://magnet.supercollider.online/
MAGNET_DOWNLOAD_BASE_URL=https://magnet.supercollider.online/
MAGNET_DOCS_BASE_URL=https://package-docs.magnet.supercollider.online/
# the redirect of `magnet login --no-browser`; a migration applies it on the first
# start, so set it before
MAGNET_OAUTH_REDIRECT_URIS=https://magnet.supercollider.online/users/display-token

POSTGRES_HOST=database
POSTGRES_DB=magnet
POSTGRES_USER=magnet
# python3 -c "import secrets; print(secrets.token_urlsafe(30))"
POSTGRES_PASSWORD=

# OVH (MX Plan): ssl0.ovh.net:465 with SSL are the defaults
EMAIL_HOST_USER=mail@supercollider.online
EMAIL_HOST_PASSWORD=

# the legal notice and privacy policy (/legal)
MAGNET_LEGAL_NAME=
MAGNET_LEGAL_EMAIL=mail@supercollider.online
# e.g. "Hetzner Online GmbH, Germany"
MAGNET_LEGAL_HOSTING=

# docs builds (docs_worker)
MAGNET_DOCS_BUILDS=1
MAGNET_DOCS_GIT_INDEX_URL=https://git.magnet.supercollider.online/magnet_index.git
# the service user's podman socket (`systemctl --user enable --now podman.socket`,
# the uid of `id -u`)
MAGNET_DOCS_SOCKET=/run/user/1000/podman/podman.sock
# an existing folder of the service user; mounted at the same path in docs_worker
MAGNET_DOCS_WORK_DIR=/home/magnet/docs-work
# the network of the install containers, the engine's default if empty (e.g. `host`
# if they can't reach the public URLs above)
MAGNET_DOCS_INSTALL_NETWORK=
